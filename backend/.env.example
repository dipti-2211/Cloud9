PORT=1710

# MongoDB — use either env var name (both are accepted)
MONGODB_URI=mongodb://localhost:27017/cloud9
# For Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/cloud9?retryWrites=true&w=majority

JWT_SECRET=<generate-64-char-random-string>

# Admin account seeded by node scripts/seedAdmin.js
ADMIN_USER_ID=admin
ADMIN_PASSWORD=<strong-password>
ADMIN_EMAIL=admin@yourdomain.com

FRONTEND_URL=https://your-frontend.vercel.app

# Python FastAPI risk engine (run locally or deployed)
RISK_ENGINE_URL=http://localhost:8000
