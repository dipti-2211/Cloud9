# ─── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store

# ─── Node / npm ───────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
package-lock.json
yarn.lock
.npm
.yarn-integrity

# ─── Environment variables ────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Build output ─────────────────────────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.output/
.svelte-kit/
**/.vitepress/dist
**/.vitepress/cache
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ─── Coverage / Testing ───────────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output

# ─── TypeScript ───────────────────────────────────────────────────────────────
*.tsbuildinfo

# ─── ESLint / Stylelint ───────────────────────────────────────────────────────
.eslintcache
.stylelintcache

# ─── Embedded MongoDB (dev fallback) ──────────────────────────────────────────
backend/.mongodb_data/

# ─── Python / Risk Engine ─────────────────────────────────────────────────────
risk-engine/.venv/
risk-engine/__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Risk engine derived rasters (generated by precompute_layers.py)
risk-engine/data/slope.tif
risk-engine/data/aspect.tif
risk-engine/data/dist_to_road.tif
risk-engine/data/_dist_to_road_utm.tif

# Large binary data files — too big for GitHub (>100MB)
*.pkl
*.nc
*.pbf
*.tar.gz
*.pdf

# Keep DEM.tif tracked (13MB — within GitHub's 100MB limit)
# If you want to also exclude it, uncomment the line below:
# risk-engine/data/DEM.tif

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
pids/
*.pid
*.seed
*.pid.lock

